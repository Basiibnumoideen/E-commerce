    {
      "name": "3. Order System",
      "item": [
        {
          "name": "POST Create Order (Authenticated User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('order_id', jsonData.data._id);",
                  "    console.log('Saved order_id to collection variables:', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"name\": \"Silk Gabardine Blazer\",\n      \"quantity\": 1,\n      \"price\": 1250.00,\n      \"image\": \"/asset/Blazer.png\"\n    },\n    {\n      \"name\": \"Classic Oxford Shirt\",\n      \"quantity\": 2,\n      \"price\": 185.00,\n      \"image\": \"/asset/shirt.png\"\n    }\n  ],\n  \"totalAmount\": 1620.00,\n  \"shippingAddress\": {\n    \"street\": \"10 Place Vendôme\",\n    \"city\": \"Paris\",\n    \"state\": \"Île-de-France\",\n    \"postalCode\": \"75001\",\n    \"country\": \"France\"\n  }\n}"
